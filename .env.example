# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# GAG CORE CONFIGURATION (Platform Independent)
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# WHATSAPP BUSINESS API (META CLOUD API) INTEGRATION
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=gag_visual_whatsapp_24_7
WHATSAPP_WEBHOOK_SECRET=

# N8N AUTOMATION PLATFORM INTEGRATION
N8N_BASE_URL=https://n8n.gagvisual.com
N8N_API_KEY=
N8N_WEBHOOK_SECRET=gag_n8n_secret_2026
N8N_WEBHOOK_URL_PREFIX=


{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account information and role inside GAG Core",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique user ID (matches auth.uid)",
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "description": "User email address",
          "maxLength": 256
        },
        "name": {
          "type": "string",
          "description": "Display name of the user",
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "description": "Access control role",
          "enum": ["SUPER_ADMIN", "ADMIN", "EDITOR", "OPERATOR", "VIEWER"]
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of creation"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last update"
        }
      },
      "required": ["id", "email", "name", "role", "createdAt"]
    },
    "Task": {
      "title": "Task",
      "description": "Operational task item for GAG Core agents and users",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique task ID",
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "description": "Title of the task",
          "maxLength": 300,
          "minLength": 1
        },
        "description": {
          "type": "string",
          "description": "Detailed explanation of task requirements",
          "maxLength": 5000
        },
        "status": {
          "type": "string",
          "description": "Current workflow status",
          "enum": ["TODO", "IN_PROGRESS", "REVIEW_REQUIRED", "DONE", "CANCELLED"]
        },
        "priority": {
          "type": "string",
          "description": "Priority level",
          "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]
        },
        "category": {
          "type": "string",
          "description": "Operational domain category",
          "maxLength": 80
        },
        "tags": {
          "type": "array",
          "description": "Labels and keywords for categorization"
        },
        "assignedAgentId": {
          "type": "string",
          "description": "ID of assigned AI agent if any",
          "maxLength": 128
        },
        "assignedUserId": {
          "type": "string",
          "description": "ID of assigned user if any",
          "maxLength": 128
        },
        "dueDate": {
          "type": "string",
          "description": "Target completion date"
        },
        "createdBy": {
          "type": "string",
          "description": "Creator user ID",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "description": "Last update timestamp"
        }
      },
      "required": ["id", "title", "status", "priority", "createdBy", "createdAt"]
    },
    "ScannedDocument": {
      "title": "ScannedDocument",
      "description": "Processed document ingested into the scanner engine",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Document identifier",
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "description": "Document file or extracted title",
          "maxLength": 300
        },
        "type": {
          "type": "string",
          "description": "Document MIME or file type",
          "maxLength": 100
        },
        "status": {
          "type": "string",
          "description": "Ingestion status",
          "enum": ["INGESTED", "REVIEW_REQUIRED", "PROCESSED", "REJECTED"]
        },
        "summary": {
          "type": "string",
          "description": "AI-generated executive summary",
          "maxLength": 4000
        },
        "extractedText": {
          "type": "string",
          "description": "Extracted OCR or raw content snippet",
          "maxLength": 20000
        },
        "tags": {
          "type": "array",
          "description": "Document tags"
        },
        "uploadedBy": {
          "type": "string",
          "description": "User ID who uploaded document",
          "maxLength": 128
        },
        "uploadedAt": {
          "type": "string",
          "description": "Upload timestamp"
        }
      },
      "required": ["id", "title", "status", "uploadedBy", "uploadedAt"]
    },
    "KnowledgeItem": {
      "title": "KnowledgeItem",
      "description": "Curated knowledge node for GAG Visual operational memory",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Knowledge identifier",
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "description": "Article or node title",
          "maxLength": 300
        },
        "category": {
          "type": "string",
          "description": "Knowledge category",
          "maxLength": 100
        },
        "content": {
          "type": "string",
          "description": "Markdown or text body",
          "maxLength": 20000
        },
        "tags": {
          "type": "array",
          "description": "Searchable tags"
        },
        "status": {
          "type": "string",
          "description": "Publication status",
          "enum": ["DRAFT", "PUBLISHED", "ARCHIVED", "FLAGGED"]
        },
        "authorId": {
          "type": "string",
          "description": "Creator user ID",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "description": "Last modified timestamp"
        }
      },
      "required": ["id", "title", "category", "content", "status", "authorId", "createdAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable security & cryptographic trail log",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Log identifier",
          "maxLength": 128
        },
        "action": {
          "type": "string",
          "description": "Action performed",
          "maxLength": 300
        },
        "capability": {
          "type": "string",
          "description": "System capability invoked",
          "maxLength": 100
        },
        "status": {
          "type": "string",
          "description": "Outcome status",
          "enum": ["SUCCESS", "REVIEW_REQUIRED", "REJECTED", "FAILED", "DENIED"]
        },
        "details": {
          "type": "string",
          "description": "Full details or metadata",
          "maxLength": 8000
        },
        "userId": {
          "type": "string",
          "description": "User identifier",
          "maxLength": 128
        },
        "userName": {
          "type": "string",
          "description": "Display name of actor",
          "maxLength": 150
        },
        "agentId": {
          "type": "string",
          "description": "Agent identifier if agent acted",
          "maxLength": 128
        },
        "agentName": {
          "type": "string",
          "description": "Agent name",
          "maxLength": 150
        },
        "hash": {
          "type": "string",
          "description": "Cryptographic signature or hash",
          "maxLength": 128
        },
        "timestamp": {
          "type": "string",
          "description": "Timestamp ISO"
        }
      },
      "required": ["id", "action", "status", "hash", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile with role-based access information"
    },
    "/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/Task" },
      "description": "Operational task collection"
    },
    "/scanned_docs/{docId}": {
      "schema": { "$ref": "#/entities/ScannedDocument" },
      "description": "Scanned documents archive"
    },
    "/knowledge/{knowledgeId}": {
      "schema": { "$ref": "#/entities/KnowledgeItem" },
      "description": "Knowledge base articles and operational guides"
    },
    "/audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Append-only cryptographic security audit trail"
    }
  }
}
